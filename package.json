{
  "name": "compasslink3d",
  "version": "1.0.0",
  "private": true,
  "description": "USB and wireless Android orientation dashboard",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean.ps1",
    "format": "prettier --write README.md package.json pc tests scripts/*.cjs",
    "format:check": "prettier --check README.md package.json pc tests scripts/*.cjs",
    "start": "node pc/server.js",
    "test": "node --test tests/*.test.js",
    "setup:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-android.ps1",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "connect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/connect-phone.ps1",
    "connect:usb": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -Mode USB",
    "connect:wireless": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -Mode Wireless"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}

