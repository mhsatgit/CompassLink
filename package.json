{
  "name": "compasslink3d",
  "version": "1.0.0",
  "private": true,
  "description": "Android sensor streaming, motion controls and customizable Windows controllers over ADB",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean.ps1",
    "format": "prettier --write README.md package.json pc tests scripts/*.cjs",
    "format:check": "prettier --check README.md package.json pc tests scripts/*.cjs",
    "start": "node pc/server.js",
    "start:gamepad": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-gamepad.ps1",
    "test": "node --test tests/*.test.js",
    "setup:adb": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-android.ps1 -PlatformToolsOnly",
    "setup:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-android.ps1",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "export:source": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-source.ps1",
    "connect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/connect-phone.ps1",
    "connect:usb": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -Mode USB",
    "connect:wireless": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -Mode Wireless",
    "connect:prebuilt:usb": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -Mode USB -SkipInstall",
    "connect:prebuilt:wireless": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -Mode Wireless -SkipInstall",
    "test:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Check"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
